# Secrets — never commit these
.env
.env.*
!.env.example

# Local TLS material for the HTTPS demo proxy. Generated per machine by the
# openssl command in infrastructure/caddy/Caddyfile — a private key never
# belongs in the repository, even a throwaway self-signed one.
infrastructure/caddy/tls.key
infrastructure/caddy/tls.crt

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# Local databases and uploads
*.db
*.sqlite
*.sqlite3
backend/storage/
storage/

# Node
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo
.eslintcache

# Hardhat
blockchain/artifacts/
blockchain/cache/
blockchain/typechain-types/
blockchain/deployments/*.json
!blockchain/deployments/.gitkeep

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# Logs
*.log
npm-debug.log*
