# =====================================================================
# CrowdWise — environment configuration
# Copy to .env and fill in. NEVER commit a real .env file.
# Every value below is a placeholder. No real secrets belong in this file.
#
# The defaults are the zero-credential demo: mock AI, demo payments, a
# simulated ledger. `docker compose up` then seed, and everything works with
# no accounts anywhere. Each provider is switched on independently below.
#
# Save this file with LF line endings. Python strips a stray CR, but not every
# tool that reads a .env does.
# =====================================================================

# ---------- Core ----------
APP_NAME=CrowdWise
ENVIRONMENT=development
LOG_LEVEL=INFO

# Master demo switch. When true: KYC is simulated, admin demo controls are
# exposed, and seeded demo data is clearly labelled. Never enable in production.
# seed.py refuses to run when this is false.
DEMO_MODE=true

# ---------- Database ----------
# Docker compose default. The `postgres` hostname only resolves inside compose;
# running the backend on the host needs localhost or the sqlite fallback.
DATABASE_URL=postgresql+psycopg://crowdwise:crowdwise@postgres:5432/crowdwise
# Zero-infra local fallback (no Postgres server needed):
# DATABASE_URL=sqlite+pysqlite:///./crowdwise.db

# ---------- Auth / session ----------
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECRET=change-me-to-another-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=14
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# ---------- URLs / CORS ----------
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------- Payments ----------
# demo     = credential-free. Issues real order ids and signs them with the same
#            HMAC construction Razorpay uses, so the verification code exercised
#            in the demo is the code that runs in production.
# razorpay = the real gateway. Test keys and live keys take the same code path.
#
# Note: seed.py needs the demo provider to fabricate its historical payments
# (real providers refuse to simulate). To seed while running Razorpay:
#   docker compose exec -e PAYMENT_PROVIDER=demo backend python seed.py --reset
# The admin "simulate payment" control is likewise demo-only, by design.
PAYMENT_PROVIDER=demo
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret
# Only needed for webhooks, which need a public HTTPS URL Razorpay can reach.
# On localhost, leave this empty: the post-checkout callback verifies the
# signature and records the contribution on its own. The webhook only adds
# out-of-band events (payment captured after the browser closed, dashboard
# refunds) and flips a `webhook_verified` display flag.
RAZORPAY_WEBHOOK_SECRET=
APPLICATION_FEE_AMOUNT=500
CURRENCY=INR

# ---------- AI: campaign analysis and community insights ----------
# mock   = deterministic heuristic analyst, no credentials needed
# nvidia = NVIDIA NIM (hosted build.nvidia.com gateway, or a self-hosted NIM)
# gemma  = any other OpenAI-compatible endpoint (Ollama, vLLM, gateway)
AI_PROVIDER=mock

# --- NVIDIA NIM ---
# Get a key from https://build.nvidia.com (it starts with `nvapi-`).
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Being listed by /v1/models does NOT mean your key can run it — an unentitled
# model returns 404. Check what you can actually reach:
#   curl -s -H "Authorization: Bearer $NVIDIA_API_KEY" \
#     https://integrate.api.nvidia.com/v1/models | jq -r '.data[].id'
# These were verified to run on a standard build.nvidia.com key:
#   nvidia/nemotron-3-super-120b-a12b
#   nvidia/nemotron-3.5-lightning-30b-a3b
#   nvidia/nemotron-3-nano-30b-a3b
#   openai/gpt-oss-120b
#   openai/gpt-oss-20b
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# Generous on purpose. Reasoning models think before answering and their latency
# varies a lot — observed 28s to 146s for one campaign analysis on the same
# model. Too low and analyses silently degrade to the heuristic fallback.
NVIDIA_TIMEOUT_SECONDS=240

# The request body is model + messages only.
# auto = ask plainly, retry with response_format only if the reply was unparseable
# on   = always send response_format   off = never send it
NVIDIA_JSON_MODE=auto

# Optional, and off by default. Leave unset unless you need them: a max_tokens
# sized for a plain instruct model truncates a reasoning model mid-thought,
# before it emits any JSON.
# NVIDIA_MAX_TOKENS=
# NVIDIA_TEMPERATURE=

# --- Generic OpenAI-compatible endpoint (Ollama / vLLM / gateway) ---
GEMMA_PROVIDER=openai_compatible
GEMMA_BASE_URL=http://localhost:11434/v1
GEMMA_API_KEY=
GEMMA_MODEL=gemma3:4b
GEMMA_TIMEOUT_SECONDS=60

# ---------- AI: sentiment ----------
# mock        = lexicon + negation classifier, no dependencies, no network
# nvidia      = the NVIDIA_* model above; classification is batched, so a
#               campaign's comments cost one call per 20, not one per comment
# xlm-roberta = local multilingual model, needs transformers + torch installed
SENTIMENT_PROVIDER=mock
# The next two apply only to SENTIMENT_PROVIDER=xlm-roberta.
SENTIMENT_MODEL=cardiffnlp/twitter-xlm-roberta-base-sentiment
SENTIMENT_DEVICE=cpu
# Regenerate community insights after this many new feedback items
COMMUNITY_INSIGHT_REFRESH_THRESHOLD=5

# ---------- Blockchain ----------
# mock = simulated in-process ledger. Needs no chain, no key, no address, and
#        every payment and governance flow behaves identically. It lives in
#        memory, so it clears on restart.
# web3 = a real EVM chain. Requires all four settings below.
BLOCKCHAIN_PROVIDER=mock
BLOCKCHAIN_NETWORK=hardhat-local

# Inside docker compose the chain is reachable by service name, NOT localhost:
#   BLOCKCHAIN_RPC_URL=http://blockchain:8545
# Use localhost only when the backend runs on the host.
BLOCKCHAIN_RPC_URL=http://blockchain:8545

# The signing account. It MUST be the contract's `recorder` — every write
# function is onlyRecorder, so any other key reverts with NotRecorder.
#
# For the local Hardhat node, do not generate a key. The node derives its
# accounts from a published mnemonic ("test test ... junk"), prints them all at
# startup, and scripts/deploy.ts makes account #0 the recorder. That account:
#   address 0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
#   key     0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# Publicly known, holds only fake ETH on a throwaway chain. NEVER reuse it on a
# public network — bots drain these addresses within seconds of any balance.
BLOCKCHAIN_PRIVATE_KEY=

# Printed by the deploy script and written to blockchain/deployments/<network>.json.
# Deterministic on a fresh Hardhat node: 0x5FbDB2315678afecb367f032d93F642f64180aa3
CONTRACT_ADDRESS=
BLOCKCHAIN_CHAIN_ID=31337
BLOCKCHAIN_EXPLORER_URL=
# Salt used to hash payment references before they touch the chain
CHAIN_HASH_SALT=change-me-chain-hash-salt

# ---------- Storage ----------
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage
STORAGE_ENDPOINT=
STORAGE_BUCKET=crowdwise
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=auto
STORAGE_PUBLIC_BASE_URL=
MAX_UPLOAD_MB=10

# ---------- KYC ----------
KYC_PROVIDER=demo

# ---------- Rate limiting ----------
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_DEFAULT_PER_MINUTE=120

# ---------- Frontend (Next.js) ----------
# NEXT_PUBLIC_* values are inlined at build time, so changing one needs a
# frontend rebuild, not just a restart:
#   docker compose up --build -d frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
